{
  "name": "restaurante",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:frontend && tsx watch src/start.ts",
    "build:frontend": "next build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:frontend && npm run build:server",
    "start": "node dist/server/src/start.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "tsx --test tests/server.test.ts tests/auth-policy.test.ts tests/auth-http.test.ts",
    "test:db": "node --env-file-if-exists=.env.test --import tsx --test tests/db-auth.integration.test.ts",
    "test:adversarial": "node --env-file-if-exists=.env.test --import tsx --test tests/adversarial-access.test.ts",
    "check:all": "npm run check && npm run test:db && npm run test:adversarial",
    "smoke": "tsx --test tests/smoke.test.ts",
    "db:local": "pwsh -NoProfile -File scripts/local-postgres.ps1 -Action prepare",
    "db:migrate": "node --env-file-if-exists=.env.admin --import tsx scripts/db-migrate.ts",
    "db:seed:demo": "node --env-file-if-exists=.env.admin --import tsx scripts/seed-demo.ts",
    "tenant:bootstrap": "node --env-file-if-exists=.env.admin --import tsx scripts/bootstrap-tenant.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm test && npm run smoke"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sequelize": "6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.1.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
