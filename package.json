{
  "name": "restaurante",
  "private": true,
  "version": "0.0.0",
  "description": "Software para restaurantes (SaaS multitenant)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@restaurante/api --filter=@restaurante/app",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:preparar": "pnpm --filter @restaurante/api db:preparar",
    "db:migrar": "pnpm --filter @restaurante/api db:migrar",
    "db:revertir": "pnpm --filter @restaurante/api db:revertir",
    "build:compartidos": "turbo run build --filter=@restaurante/api^...",
    "db:semilla": "pnpm build:compartidos && pnpm --filter @restaurante/api db:semilla",
    "plataforma:superadmin": "pnpm build:compartidos && pnpm --filter @restaurante/api plataforma:superadmin",
    "puente:simular": "pnpm build:compartidos && pnpm --filter @restaurante/api puente:simular",
    "local:preparar": "node scripts/local-preparar.mjs"
  },
  "devDependencies": {
    "@restaurante/config": "workspace:*",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
