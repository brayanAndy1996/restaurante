# Carta web (apps/web, Next.js; historia 005). Copia este archivo a .env.local para `pnpm --filter @restaurante/web dev`
# (puerto 3001). Next solo expone al navegador las variables que empiezan con NEXT_PUBLIC_, y las incrusta al
# construir: cámbiala y vuelve a construir.

# URL de la API para el servidor de Next (red interna; en docker-compose, el nombre del servicio). Lee la carta y la
# mesa. Sin barra final.
API_URL_INTERNA=http://localhost:3000

# URL pública de la API, la que usa el navegador del cliente (disponibilidad, llamados y su estado). Debe estar en
# los orígenes que la API acepta por CORS para /publico/*, que salen de CARTA_WEB_URL. Sin barra final.
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL pública de esta aplicación, sin barra final: la que llevan los QR de las mesas y las vistas previas al compartir.
# La API usa el mismo valor.
CARTA_WEB_URL=http://localhost:3001

# URL base pública de los archivos (fotos y logos), la misma de la API: next/image solo optimiza imágenes de este
# origen. En desarrollo, la API; en producción, el dominio público del bucket.
ARCHIVOS_URL_PUBLICA=http://localhost:3000/archivos
