{
  "name": "@restaurante/web",
  "version": "0.0.0",
  "private": true,
  "description": "Carta web y modo mesa del cliente (Next.js), pensada para el celular propio y los datos móviles",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "presupuesto": "node scripts/presupuesto.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@restaurante/contratos": "workspace:*",
    "@restaurante/dominio": "workspace:*",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@restaurante/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
