{
  "name": "@restaurante/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PWA del personal del restaurante (React + Vite), móvil primero",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "presupuesto": "node scripts/presupuesto.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@restaurante/contratos": "workspace:*",
    "@restaurante/dominio": "workspace:*",
    "@restaurante/ui": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "decimal.js": "10.6.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@restaurante/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
