{
  "name": "@restaurante/api",
  "version": "0.0.0",
  "private": true,
  "description": "API NestJS + Sequelize + PostgreSQL (y el worker)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:preparar": "tsx scripts/preparar-bd.ts",
    "db:migrar": "tsx scripts/migrar.ts",
    "db:revertir": "tsx scripts/migrar.ts revertir",
    "db:semilla": "tsx scripts/semilla.ts",
    "plataforma:superadmin": "tsx scripts/superadministrador.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@restaurante/contratos": "workspace:*",
    "@restaurante/dominio": "workspace:*",
    "@socket.io/postgres-adapter": "0.5.0",
    "aws4fetch": "1.0.20",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "socket.io": "4.8.4",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.8",
    "@restaurante/config": "workspace:*",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "socket.io-client": "4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.12"
  }
}
