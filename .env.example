# Copia este archivo a .env (pnpm local:preparar lo hace por ti).
# Contraseñas y URLs de desarrollo local: NO usar en producción.

# Obligatoria, sin valor por defecto: development, test o production. Sin ella la API no arranca y
# db:preparar no usa las contraseñas por defecto de abajo (solo valen con development o test).
NODE_ENV=development
PORT=3000

# Administrador de PostgreSQL: solo lo usan db:preparar y las pruebas.
# El docker-compose.yml publica PostgreSQL en el puerto 5433.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/postgres

# Solo db:preparar. Déjala comentada con un administrador superusuario (aplica las protecciones del
# catálogo: criterios 38b, 38c, 38d y la capa de base de 22d). En producción con PostgreSQL administrado,
# sin superusuario, descoméntala: `omitir` prepara roles y base sin esas protecciones y avisa; quedan solo
# en la guarda de la API y la de plataforma (criterio 38e). Cualquier otro valor es un error.
# DB_PROTECCION_CATALOGO=omitir

# Contraseñas que db:preparar asigna a los roles. Con NODE_ENV=development o test explícito, si faltan
# se usan los valores de abajo; con production (o sin NODE_ENV) son obligatorias.
DB_PASSWORD_MIGRADOR=migrador_local
DB_PASSWORD_API=api_local
DB_PASSWORD_PLATAFORMA=plataforma_local

# Conexiones de la aplicación, una por rol.
DATABASE_URL=postgres://restaurante_api:api_local@localhost:5433/restaurante
DATABASE_PLATAFORMA_URL=postgres://restaurante_plataforma:plataforma_local@localhost:5433/restaurante
DATABASE_MIGRADOR_URL=postgres://restaurante_migrador:migrador_local@localhost:5433/restaurante

# Tamaño del pool de la API.
DB_POOL_MAX=10

# Resolutor de empresa por cabecera x-empresa-id. Solo desarrollo y pruebas;
# la API se niega a arrancar con esta opción si NODE_ENV=production.
# (Historia 002: pasará a valer solo con NODE_ENV=test; la sesión será la única fuente de la empresa.)
EMPRESA_POR_HEADER=habilitado

# Secreto con el que se calcula la huella de los PIN (base64, 32 bytes o más). Con NODE_ENV=development
# o test, si falta, se usa un valor local; en producción será obligatoria. Genera una con
# `openssl rand -base64 32`. Cambiarla invalida todos los PIN. Nunca la subas al repositorio.
PIN_PEPPER=cGluLXBlcHBlci1zb2xvLXBhcmEtZGVzYXJyb2xsbyE=

# Orígenes de la PWA permitidos por CORS, separados por coma, sin ruta ni barra final. Con
# NODE_ENV=development o test, si falta, es http://localhost:5173; en producción será obligatoria.
ORIGENES_PERMITIDOS=http://localhost:5173
