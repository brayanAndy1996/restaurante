# Copia este archivo a .env (pnpm local:preparar lo hace por ti).
# Contraseñas y URLs de desarrollo local: NO usar en producción.

# Obligatoria, sin valor por defecto: development, test o production. Sin ella la API no arranca y
# db:preparar no usa las contraseñas por defecto de abajo (solo valen con development o test).
NODE_ENV=development
PORT=3000

# Administrador de PostgreSQL: solo lo usan db:preparar y las pruebas.
# El docker-compose.yml publica PostgreSQL en el puerto 5433. Si en tu computadora ese puerto ya está en
# uso (por ejemplo, por un PostgreSQL instalado), descomenta DB_PUERTO_LOCAL con otro puerto libre y usa
# ese mismo número en las cuatro URL de la base (DATABASE_ADMIN_URL, DATABASE_URL y las dos siguientes).
# DB_PUERTO_LOCAL=5434
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/postgres

# Solo db:preparar. Déjala comentada con un administrador superusuario (aplica las protecciones del
# catálogo: criterios 38b, 38c, 38d y la capa de base de 22d). En producción con PostgreSQL administrado,
# sin superusuario, descoméntala: `omitir` prepara roles y base sin esas protecciones y avisa; quedan solo
# en la guarda de la API y la de plataforma (criterio 38e). Cualquier otro valor es un error.
# DB_PROTECCION_CATALOGO=omitir

# Contraseñas que db:preparar asigna a los roles. Con NODE_ENV=development o test explícito, si faltan
# se usan los valores de abajo; con production (o sin NODE_ENV) son obligatorias.
DB_PASSWORD_MIGRADOR=migrador_local
DB_PASSWORD_API=api_local
DB_PASSWORD_PLATAFORMA=plataforma_local
DB_PASSWORD_TIEMPO_REAL=tiempo_real_local
# Facturación electrónica (historia 006, 6b): la cola de envíos al PSE y la carga del padrón de RUC.
DB_PASSWORD_COLAS=colas_local
DB_PASSWORD_REFERENCIA=referencia_local

# Conexiones de la aplicación, una por rol.
DATABASE_URL=postgres://restaurante_api:api_local@localhost:5433/restaurante
DATABASE_PLATAFORMA_URL=postgres://restaurante_plataforma:plataforma_local@localhost:5433/restaurante
DATABASE_MIGRADOR_URL=postgres://restaurante_migrador:migrador_local@localhost:5433/restaurante
# Tiempo real (historia 004, Socket.IO): conexión del adaptador de PostgreSQL con el rol restaurante_tiempo_real
# (sin privilegios sobre las tablas de public; usa 2 conexiones). Obligatoria con TIEMPO_REAL=habilitado.
DATABASE_TIEMPO_REAL_URL=postgres://restaurante_tiempo_real:tiempo_real_local@localhost:5433/restaurante
# habilitado o deshabilitado. Si falta, vale habilitado salvo con NODE_ENV=test (las pruebas lo habilitan donde
# lo necesitan).
TIEMPO_REAL=habilitado
# URL pública de la API (historia 004, 3b): la que va en el QR de vinculación del puente de impresión. Con
# development y test, si falta, vale http://localhost:<PORT>; en producción hay que definirla.
API_URL_PUBLICA=http://localhost:3000

# Carta web y pedido desde la mesa (historia 005). URL base pública de la carta (apps/web), sin barra final: la que
# llevan los QR de las mesas (<CARTA_WEB_URL>/m/<código>), los enlaces de Ajustes > Carta web y el origen que CORS
# acepta además en /publico/*. Con development y test, si falta, vale http://localhost:3001; en producción hay que
# definirla (sin ella la API avisa al arrancar y las rutas de QR responden 503).
CARTA_WEB_URL=http://localhost:3001
# Carta web (apps/web): IMAGENES_PERMITIR_IP_LOCAL=1 permite optimizar las fotos y logos que salen de una dirección
# local (localhost, 127.0.0.1). SOLO PARA DESARROLLO Y PRUEBAS E2E y comentada a propósito: este archivo se copia a
# `.env`, que también lee la API, y en producción NO se define (las fotos salen del dominio público del bucket).
# `pnpm local:preparar` la activa solo en `apps/web/.env.local`. Solo si construyes la imagen de Docker de la carta
# web en tu computadora (docker-compose.yml la toma de aquí) descomenta la línea; la carta web no construye si vale 1 y
# sus direcciones públicas no son locales.
# IMAGENES_PERMITIR_IP_LOCAL=1
# Cabecera con la IP real del cliente, para el límite de llamados por conexión (la IP nunca se guarda: solo su
# huella). Detrás de Cloudflare: cf-connecting-ip. Si falta, se usa la IP de la conexión.
# CABECERA_IP_CLIENTE=cf-connecting-ip

# Tamaño del pool de la API.
DB_POOL_MAX=10

# EMPRESA_POR_HEADER=habilitado (cabecera x-empresa-id sin sesión) es solo para las pruebas automáticas y
# solo vale con NODE_ENV=test: la API se niega a arrancar con ella en development y en production. La
# empresa de cada petición sale de la sesión; no la pongas aquí.

# Secreto con el que se calcula la huella de los PIN (base64, 32 bytes o más). Con NODE_ENV=development
# o test, si falta, se usa un valor local; en producción es obligatoria. Genera una con
# `openssl rand -base64 32`. Cambiarla invalida todos los PIN. Nunca la subas al repositorio.
PIN_PEPPER=cGluLXBlcHBlci1zb2xvLXBhcmEtZGVzYXJyb2xsbyE=

# Cuántos scrypt de ingreso corren a la vez (CupoScrypt) sale de UV_THREADPOOL_SIZE y de los núcleos:
# max(1, min(UV_THREADPOOL_SIZE - 1, núcleos - 1)). Con 4 hilos (el valor por defecto de Node) y 4 núcleos son
# 3; con 2 núcleos o menos baja a 1. Para dar más cupos, sube las dos cosas; la variable tiene que existir
# antes de que arranque el proceso de Node.
# UV_THREADPOOL_SIZE=4

# Orígenes de la PWA permitidos por CORS, separados por coma, sin ruta ni barra final. Con
# NODE_ENV=development o test, si falta, es http://localhost:5173; en producción es obligatoria.
ORIGENES_PERMITIDOS=http://localhost:5173

# Solo para automatizar `pnpm plataforma:superadmin crear` y `pnpm db:semilla`: contraseña del
# superadministrador (si falta, el script la pide y la semilla usa la de demostración). Nunca como argumento.
# SUPERADMIN_CONTRASENA=

# URL de la API para la PWA (apps/app, `pnpm dev`). Vite solo expone al navegador las variables que
# empiezan con VITE_: ninguna de las de arriba llega a la PWA. Sin ella, la PWA usa http://localhost:3000.
# VITE_API_URL=http://localhost:3000

# Almacén de archivos: las fotos de la carta (historia 003). `memoria` (con NODE_ENV=test, es lo que usan las
# pruebas), `disco` (solo con NODE_ENV=development: la carpeta de ARCHIVOS_DIRECTORIO, que la API sirve en
# /archivos/*) o `r2` (Cloudflare R2, obligatorio en producción). Si falta, vale `disco` con development y
# `memoria` con test; la API no arranca con `disco` fuera de development ni en producción sin `r2`.
ARCHIVOS_DRIVER=disco
# Carpeta del almacén en disco (solo desarrollo).
ARCHIVOS_DIRECTORIO=./archivos
# URL base pública de los archivos. En desarrollo, la de la API: http://localhost:3000/archivos
ARCHIVOS_URL_PUBLICA=http://localhost:3000/archivos
# Credenciales del bucket de Cloudflare R2: obligatorias con ARCHIVOS_DRIVER=r2, junto con ARCHIVOS_URL_PUBLICA
# (el dominio público del bucket, por ejemplo https://fotos.ejemplo.pe). El token debe tener permiso solo sobre
# ese bucket. Nunca las subas al repositorio.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Facturación electrónica (historia 006, entrega 6b). Todo corre con el PSE simulado hasta que se elija el PSE real (T34).
# Rol de la cola de envíos al PSE (pg-boss; dueño del esquema `colas`, sin privilegios sobre las tablas de `public`).
# Obligatoria en producción; en desarrollo, si falta, la cola es en memoria y no procesa nada. Para que los comprobantes
# se envíen de verdad en desarrollo (y en las E2E de 6b) define esta variable, `DATABASE_REFERENCIA_URL` y `WORKER=habilitado`.
# DATABASE_COLAS_URL=postgres://restaurante_colas:colas_local@localhost:5433/restaurante
# Rol de la carga del padrón de RUC (solo lo usa el worker; solo tiene privilegios sobre el esquema `referencia`).
# DATABASE_REFERENCIA_URL=postgres://restaurante_referencia:referencia_local@localhost:5433/restaurante
# `simulador` o el código del adaptador real. Con development y test, si falta, vale `simulador`; obligatoria en producción.
# PSE_CONECTOR=simulador
# Tiempo máximo de cada llamada al PSE, en milisegundos (por defecto 30000).
# PSE_TIMEOUT_MS=30000
# Clave maestra del cifrado de las credenciales del PSE y de los enlaces de los comprobantes (base64, 32 bytes o más;
# `openssl rand -base64 32`). Con development y test, si falta, se usa un valor fijo; en producción es obligatoria.
# CLAVE_CIFRADO=
# Clave anterior, solo para descifrar mientras se rota CLAVE_CIFRADO.
# CLAVE_CIFRADO_ANTERIOR=
# `habilitado` corre el worker de envíos dentro del proceso de la API; por defecto `deshabilitado` y siempre así con
# NODE_ENV=test. El worker también corre como proceso aparte (`node dist/worker.js`).
# WORKER=deshabilitado
# Archivo del padrón reducido de RUC de SUNAT (por defecto la dirección pública de SUNAT; `file://…` en las pruebas).
# PADRON_RUC_URL=
# Para las demos y las E2E, el padrón de ejemplo del repositorio (7 RUC, entre ellos uno con BAJA DE OFICIO / NO HABIDO):
# PADRON_RUC_URL=file:///ruta/al/repositorio/apps/api/test/soporte/padron-ejemplo.zip
# y se carga con `POST /plataforma/padron/carga` (superadministrador); el worker la procesa.
# Bucket PRIVADO de los XML, CDR y PDF de los comprobantes (distinto de R2_BUCKET, que es público). Obligatorio con
# ARCHIVOS_DRIVER=r2. En desarrollo con `disco`, la carpeta es ARCHIVOS_COMPROBANTES_DIRECTORIO (la API nunca la sirve).
# R2_BUCKET_COMPROBANTES=
# ARCHIVOS_COMPROBANTES_DIRECTORIO=./archivos-privados

# E2E de la facturación electrónica (apps/app/e2e/facturacion.spec.ts, T45). La API de esa prueba es la de
# `apps/app/e2e/soporte/api-con-simulador.cjs` (la API compilada con un SimuladorPse propio); necesita lo de arriba:
# DATABASE_COLAS_URL, DATABASE_REFERENCIA_URL, WORKER=habilitado, PADRON_RUC_URL (el archivo de ejemplo) y API_URL_PUBLICA
# igual a la dirección de la API de la prueba. Las reglas del simulador se mueven por un puerto de control:
# E2E_PSE_CONTROL_PUERTO=3100   (el que escucha la API de la prueba, solo en 127.0.0.1)
# E2E_PSE_CONTROL_URL=http://127.0.0.1:3100   (el que usa la prueba para llegar a él)
