RESTAURANTE_MODE=cloud
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Sin DATABASE_URL solo se habilita el diagnóstico.
# scripts/local-postgres.ps1 genera .env, .env.admin y .env.test de desarrollo
# con secretos aleatorios; no sobrescribe configuraciones existentes.
# DATABASE_URL=postgresql://RUNTIME_USER:REEMPLAZAR@127.0.0.1:55432/restaurante_demo
# AUTH_HMAC_SECRET=GENERAR_AL_MENOS_32_BYTES_ALEATORIOS
# No incluir MIGRATION_DATABASE_URL en el entorno del servidor HTTP.
